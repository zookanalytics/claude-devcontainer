{
  // DevPod-specific devcontainer configuration
  // ==========================================
  // This file ONLY contains DevPod-specific overrides. The base configuration
  // (remoteUser, mounts, containerEnv, postCreateCommand, etc.) is embedded
  // in the Docker image via LABEL devcontainer.metadata. DevPod merges both.
  //
  // Use the wrapper script: ./scripts/devpod-up <instance-id> [repo]
  // Example: devpod-up agent-1 → workspace "main-agent-1" → container "main-agent-1"

  "name": "${localEnv:DEVPOD_WORKSPACE_ID}",
  "image": "ghcr.io/zookanalytics/claude-devcontainer:latest",

  // Container naming requires runArgs (can't use capAdd in LABEL for --name)
  "runArgs": [
    "--name=${localEnv:DEVPOD_WORKSPACE_ID}"
  ],

  // DevPod-specific environment variables (additions to image defaults)
  // Note: Image LABEL provides base containerEnv; these are merged/overridden
  "containerEnv": {
    "CLAUDE_INSTANCE": "${localEnv:DEVPOD_WORKSPACE_ID}",
    "DEVPOD_WORKSPACE_ID": "${localEnv:DEVPOD_WORKSPACE_ID}",
    "PROJECT_NAME": "claude-devcontainer",
    "WORKSPACE_ROOT": "${containerWorkspaceFolder}",
    "npm_config_virtual_store_dir": ".pnpm-store/container/${localEnv:DEVPOD_WORKSPACE_ID}"
  },

  // VS Code customizations (additions to image defaults)
  "customizations": {
    "vscode": {
      "settings": {
        "window.title": "${containerEnv:CLAUDE_INSTANCE}${separator}${activeRepositoryBranchName}${dirty}",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          },
          "tmux": {
            "path": "/home/node/.local/bin/tmux-session"
          }
        },
        "geminicodeassist.agentYoloMode": true
      },
      "extensions": [
        "appulate.filewatcher",
        "bierner.markdown-mermaid",
        "bierner.markdown-footnotes",
        "DavidAnson.vscode-markdownlint",
        "github.vscode-github-actions",
        "ms-playwright.playwright",
        "RobertOstermann.better-status-bar",
        "usernamehw.errorlens"
      ]
    }
  }
}
