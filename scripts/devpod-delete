#!/usr/bin/env bash
# devpod-delete: Safety wrapper for 'devpod delete' that checks for uncommitted work
#
# This script:
# 1. Checks for uncommitted changes (modified, staged, untracked)
# 2. Checks for unpushed commits on ALL branches
# 3. Checks for stashed changes
# 4. Requires --force to delete if issues found
#
# Usage:
#   devpod-delete <workspace-name>
#   devpod-delete --force <workspace-name>
#
# Examples:
#   devpod-delete myrepo-agent-1
#   # Shows warnings if uncommitted work exists
#
#   devpod-delete --force myrepo-agent-1
#   # Deletes even with uncommitted work

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
    cat <<EOF
Usage: devpod-delete [options] <workspace-name>

Safety wrapper for 'devpod delete' that checks for uncommitted work.

Options:
  --force       Delete workspace even if it has uncommitted/unpushed work
  --skip-check  Skip safety checks entirely (faster, less safe)
  -h, --help    Show this help message

The script will:
  1. Check for uncommitted changes (modified, staged, untracked files)
  2. Check for unpushed commits on ALL branches
  3. Check for stashed changes
  4. Warn and require --force if any issues found

Examples:
  devpod-delete myrepo-agent-1
  devpod-delete --force myrepo-agent-1
EOF
    exit 1
}

# Check if devpod is installed
if ! command -v devpod &>/dev/null; then
    echo -e "${RED}Error: devpod CLI is not installed${NC}"
    echo "Install from: https://devpod.sh/docs/getting-started/install"
    exit 1
fi

# Parse arguments
FORCE=false
SKIP_CHECK=false
WORKSPACE=""
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --force)
            FORCE=true
            shift
            ;;
        --skip-check)
            SKIP_CHECK=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            # Pass through other flags to devpod delete
            EXTRA_ARGS+=("$1")
            shift
            ;;
        *)
            if [[ -z "$WORKSPACE" ]]; then
                WORKSPACE="$1"
            else
                EXTRA_ARGS+=("$1")
            fi
            shift
            ;;
    esac
done

if [[ -z "$WORKSPACE" ]]; then
    echo -e "${RED}Error: Workspace name required${NC}"
    echo ""
    usage
fi

# Check if workspace exists
if ! devpod list --output json 2>/dev/null | grep -q "\"id\":\"$WORKSPACE\""; then
    echo -e "${RED}Error: Workspace '$WORKSPACE' not found${NC}"
    echo ""
    echo "Available workspaces:"
    devpod list 2>/dev/null || echo "  (none)"
    exit 1
fi

# Skip safety checks if requested
if [[ "$SKIP_CHECK" == true ]]; then
    echo -e "${YELLOW}Skipping safety checks (--skip-check)${NC}"
    exec devpod delete "$WORKSPACE" "${EXTRA_ARGS[@]}"
fi

# Run safety checks by executing git commands inside the workspace
echo -e "${BLUE}Checking workspace for uncommitted work...${NC}"

# Build a script to run inside the container that outputs structured data
# Note: DevPod mounts workspaces at /workspaces/<workspace-id>
# We use a heredoc to avoid quoting issues, then pass via variable
read -r -d '' CHECK_SCRIPT << 'CHECKEOF' || true
WORKSPACE_PATH="/workspaces/__WORKSPACE_PLACEHOLDER__"
cd "$WORKSPACE_PATH" 2>/dev/null || {
    echo "WORKSPACE_NOT_FOUND"
    exit 1
}

# Verify git repo (workspaces should always be git repos)
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "NOT_GIT_REPO"
    exit 1
fi

# Refresh git index
git update-index --refresh -q >/dev/null 2>&1 || true

# Check for uncommitted changes
UNCOMMITTED=""
if ! git diff-index --quiet HEAD -- 2>/dev/null; then
    UNCOMMITTED="${UNCOMMITTED}modified "
fi
if ! git diff-index --quiet --cached HEAD -- 2>/dev/null; then
    UNCOMMITTED="${UNCOMMITTED}staged "
fi
UNTRACKED=$(git ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d " ")
if [ "$UNTRACKED" -gt 0 ]; then
    UNCOMMITTED="${UNCOMMITTED}untracked:${UNTRACKED} "
fi

# Check ALL branches for unpushed commits
UNPUSHED=""
for branch in $(git branch --format="%(refname:short)" 2>/dev/null); do
    if git rev-parse --abbrev-ref "${branch}@{upstream}" >/dev/null 2>&1; then
        count=$(git rev-list --count "${branch}@{upstream}..${branch}" 2>/dev/null || echo "0")
        if [ "$count" -gt 0 ]; then
            UNPUSHED="${UNPUSHED}${branch}:${count} "
        fi
    else
        # Branch has no upstream - check if it has commits
        count=$(git rev-list --count "$branch" 2>/dev/null || echo "0")
        if [ "$count" -gt 0 ]; then
            UNPUSHED="${UNPUSHED}${branch}:no-remote:${count} "
        fi
    fi
done

# Check for stashes
STASH_COUNT=$(git stash list 2>/dev/null | wc -l | tr -d " ")

# Output results
echo "UNCOMMITTED:${UNCOMMITTED:-none}"
echo "UNPUSHED:${UNPUSHED:-none}"
echo "STASHES:${STASH_COUNT}"
CHECKEOF

# Substitute the actual workspace name into the script
CHECK_SCRIPT="${CHECK_SCRIPT//__WORKSPACE_PLACEHOLDER__/$WORKSPACE}"

# Try to run the check script inside the workspace
# devpod ssh runs commands inside the workspace container
CHECK_OUTPUT=$(devpod ssh "$WORKSPACE" --command "$CHECK_SCRIPT" 2>/dev/null) || {
    echo -e "${YELLOW}Warning: Could not connect to workspace to check git state${NC}"
    echo "The workspace may be stopped or inaccessible."
    echo ""
    if [[ "$FORCE" == true ]]; then
        echo -e "${YELLOW}Proceeding with --force...${NC}"
        exec devpod delete "$WORKSPACE" "${EXTRA_ARGS[@]}"
    else
        echo "Use --force to delete anyway, or --skip-check to skip safety checks."
        exit 1
    fi
}

# Check for workspace/git errors
if echo "$CHECK_OUTPUT" | grep -q "WORKSPACE_NOT_FOUND"; then
    echo -e "${YELLOW}Warning: Could not find workspace directory at /workspaces/$WORKSPACE${NC}"
    if [[ "$FORCE" == true ]]; then
        exec devpod delete "$WORKSPACE" "${EXTRA_ARGS[@]}"
    else
        echo "Use --force to delete anyway."
        exit 1
    fi
fi

if echo "$CHECK_OUTPUT" | grep -q "NOT_GIT_REPO"; then
    echo -e "${YELLOW}Warning: Workspace is not a git repository${NC}"
    if [[ "$FORCE" == true ]]; then
        exec devpod delete "$WORKSPACE" "${EXTRA_ARGS[@]}"
    else
        echo "Use --force to delete anyway."
        exit 1
    fi
fi

# Parse results
UNCOMMITTED=$(echo "$CHECK_OUTPUT" | grep "^UNCOMMITTED:" | cut -d: -f2-)
UNPUSHED=$(echo "$CHECK_OUTPUT" | grep "^UNPUSHED:" | cut -d: -f2-)
STASHES=$(echo "$CHECK_OUTPUT" | grep "^STASHES:" | cut -d: -f2)

# Build list of issues
HAS_ISSUES=false
ISSUES=()

if [[ "$UNCOMMITTED" != "none" && -n "$UNCOMMITTED" ]]; then
    HAS_ISSUES=true
fi

if [[ "$UNPUSHED" != "none" && -n "$UNPUSHED" ]]; then
    HAS_ISSUES=true
fi

if [[ "$STASHES" -gt 0 ]]; then
    HAS_ISSUES=true
fi

# Display warnings if issues found
if [[ "$HAS_ISSUES" == true ]]; then
    echo ""
    echo -e "${RED}WARNING: Workspace has unsaved work!${NC}"
    echo ""

    if [[ "$UNCOMMITTED" != "none" && -n "$UNCOMMITTED" ]]; then
        echo -e "${YELLOW}Uncommitted changes:${NC}"
        for item in $UNCOMMITTED; do
            case "$item" in
                modified)
                    echo "  - Modified files not committed"
                    ;;
                staged)
                    echo "  - Staged changes not committed"
                    ;;
                untracked:*)
                    count="${item#untracked:}"
                    echo "  - $count untracked file(s)"
                    ;;
            esac
        done
        echo ""
    fi

    if [[ "$UNPUSHED" != "none" && -n "$UNPUSHED" ]]; then
        echo -e "${YELLOW}Unpushed branches:${NC}"
        for item in $UNPUSHED; do
            branch="${item%%:*}"
            rest="${item#*:}"
            if [[ "$rest" == no-remote:* ]]; then
                count="${rest#no-remote:}"
                echo "  - $branch (no remote, $count commit(s))"
            else
                count="$rest"
                echo "  - $branch ($count commit(s))"
            fi
        done
        echo ""
    fi

    if [[ "$STASHES" -gt 0 ]]; then
        echo -e "${YELLOW}Stashed changes:${NC} $STASHES stash(es)"
        echo ""
    fi

    if [[ "$FORCE" == false ]]; then
        echo "Use --force to delete anyway, or commit/push your work first."
        exit 1
    else
        echo -e "${RED}Using --force flag. Work will be lost!${NC}"
        echo ""
    fi
else
    echo -e "${GREEN}No uncommitted work found${NC}"
fi

# Proceed with deletion
echo -e "${BLUE}Deleting workspace '$WORKSPACE'...${NC}"
devpod delete "$WORKSPACE" "${EXTRA_ARGS[@]}"
echo -e "${GREEN}Workspace '$WORKSPACE' deleted${NC}"
