#!/usr/bin/env bash
# devpod-up: Wrapper for 'devpod up' that ensures proper container naming
#
# This script:
# 1. Auto-prefixes instance ID with repo name (ensures global uniqueness)
# 2. Exports DEVPOD_WORKSPACE_ID for devcontainer.json templating
# 3. Uses the devpod-specific devcontainer.json
# 4. Optionally builds and uses local Docker image (--local flag)
#
# Usage:
#   devpod-up <instance-id> [repo] [options...]
#   devpod-up --local <instance-id> [repo] [options...]
#   devpod-up --pull <instance-id> [repo] [options...]
#
# Examples:
#   devpod-up agent-1 https://github.com/user/myrepo
#   # Creates workspace & container: myrepo-agent-1
#
#   devpod-up --local agent-1
#   # Builds local image first, then creates workspace
#
#   devpod-up --pull agent-1
#   # Pulls fresh remote image (invalidates Docker cache)
#
# The full workspace ID becomes: <repo-name>-<instance-id>

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Script location (used for finding Dockerfile and devcontainer.json)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

LOCAL_BUILD=false
LOCAL_IMAGE="claude-devcontainer:local"
FALLBACK_IMAGE="ghcr.io/zookanalytics/claude-devcontainer:latest"
NO_IDE=false
USE_GIT_REMOTE=false
PULL_FRESH=false
USE_DEVPOD_CONFIG=false
DEVPOD_REPOS_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/devpod-up/repos"

usage() {
    cat <<EOF
Usage: devpod-up [options] <instance-id> [repo] [devpod-options...]

Creates a DevPod workspace with proper naming for multi-repo use.

For repos without devcontainer.json, the fallback image provides a full
Claude DevContainer environment with firewall, credentials, and tools.

Options:
  --local         Build and use local Docker image instead of remote
  --no-ide        Start without opening an IDE
  --git           Use git remote URL instead of local checkout (fresh clone)
  --pull          Pull fresh remote image (invalidates Docker cache)
  --devpod-config Use .devcontainer/devpod/devcontainer.json from repo

Config file:
  ~/.config/devpod-up/repos    List of repo patterns (one per line) that
                               automatically enable --devpod-config

Arguments:
  instance-id     Short instance name (e.g., agent-1, dev)
  repo            Git URL or local path (default: current directory)
  devpod-options  Additional options passed to 'devpod up'

The workspace ID will be: <repo-name>-<instance-id>
This ensures uniqueness across different repositories.

Examples:
  devpod-up agent-1 https://github.com/user/myrepo
  # Workspace ID: myrepo-agent-1

  devpod-up --local --no-ide agent-1
  # Builds local image, no IDE, creates: main-agent-1

  devpod-up dev /path/to/signal-loom
  # Workspace ID: signal-loom-dev

  devpod-up explore https://github.com/expressjs/express
  # Uses fallback image for third-party repo (no devcontainer.json needed)

  devpod-up --git agent-1
  # Uses git remote URL of current directory (fresh clone, not local mount)

  devpod-up --pull agent-1 https://github.com/user/repo
  # Pulls latest remote image before creating workspace
EOF
    exit 1
}

if ! command -v devpod &>/dev/null; then
    echo -e "${RED}Error: devpod CLI is not installed${NC}"
    echo "Install from: https://devpod.sh/docs/getting-started/install"
    exit 1
fi

if [[ $# -lt 1 ]]; then
    usage
fi

# Parse flags
while [[ $# -gt 0 && "$1" == --* ]]; do
    case "$1" in
        --local)
            LOCAL_BUILD=true
            shift
            ;;
        --no-ide)
            NO_IDE=true
            shift
            ;;
        --git)
            USE_GIT_REMOTE=true
            shift
            ;;
        --pull)
            PULL_FRESH=true
            shift
            ;;
        --devpod-config)
            USE_DEVPOD_CONFIG=true
            shift
            ;;
        --help)
            usage
            ;;
        *)
            break
            ;;
    esac
done

if [[ $# -lt 1 ]]; then
    usage
fi

SHORT_ID="$1"
shift

if [[ ! "$SHORT_ID" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
    echo -e "${RED}Error: Invalid instance ID '$SHORT_ID'${NC}"
    echo "Must start with alphanumeric, contain only a-z, 0-9, hyphens, underscores"
    exit 1
fi

# Determine repo source - next arg if it doesn't start with -
REPO="."
if [[ $# -gt 0 && ! "$1" =~ ^- ]]; then
    REPO="$1"
    shift
fi

# If --git flag is used, resolve local path to git remote URL
if [[ "$USE_GIT_REMOTE" == true ]]; then
    # Determine the directory to check for git remote
    if [[ "$REPO" == "." ]]; then
        GIT_DIR="$PWD"
    elif [[ -d "$REPO" ]]; then
        GIT_DIR="$REPO"
    else
        echo -e "${RED}Error: --git requires a local directory, got: $REPO${NC}"
        exit 1
    fi

    # Get the git remote URL
    GIT_REMOTE=$(git -C "$GIT_DIR" remote get-url origin 2>/dev/null) || {
        echo -e "${RED}Error: No git remote 'origin' found in $GIT_DIR${NC}"
        echo "Make sure you're in a git repository with a remote configured."
        exit 1
    }

    echo -e "${BLUE}Using git remote instead of local checkout${NC}"
    echo -e "  Remote: $GIT_REMOTE"
    echo ""
    REPO="$GIT_REMOTE"
fi

# Extract repo name for prefixing and detect if remote
IS_REMOTE=false
if [[ "$REPO" == "." ]]; then
    REPO_NAME="$(basename "$PWD")"
elif [[ "$REPO" =~ ^https?:// ]]; then
    # HTTPS: https://github.com/user/repo.git -> repo
    REPO_NAME="$(basename "$REPO" .git)"
    IS_REMOTE=true
elif [[ "$REPO" =~ ^git@ ]]; then
    # SSH: git@github.com:user/repo.git -> repo
    REPO_NAME="$(basename "$REPO" .git)"
    IS_REMOTE=true
else
    # Local path
    REPO_NAME="$(basename "$REPO")"
fi

# Check if repo matches patterns in config file (auto-enable --devpod-config)
if [[ "$USE_DEVPOD_CONFIG" == false && -f "$DEVPOD_REPOS_CONFIG" ]]; then
    while IFS= read -r pattern || [[ -n "$pattern" ]]; do
        # Skip empty lines and comments
        [[ -z "$pattern" || "$pattern" == \#* ]] && continue
        if [[ "$REPO" == *"$pattern"* ]]; then
            USE_DEVPOD_CONFIG=true
            break
        fi
    done < "$DEVPOD_REPOS_CONFIG"
fi

# Full workspace ID = repo-instance (globally unique)
# This becomes both the DevPod workspace ID and Docker container name
WORKSPACE_ID="${REPO_NAME}-${SHORT_ID}"

export DEVPOD_WORKSPACE_ID="$WORKSPACE_ID"

# Check if DevPod workspace already exists
if devpod list --output json 2>/dev/null | grep -q "\"id\":\"$WORKSPACE_ID\""; then
    echo -e "${RED}Error: Workspace '$WORKSPACE_ID' already exists${NC}"
    echo ""
    echo "To start it:  devpod up $WORKSPACE_ID"
    echo "To delete it: devpod delete $WORKSPACE_ID"
    exit 1
fi

# Check if Docker container with that name already exists (orphaned from deleted workspace)
# Use -Fx for fixed-string exact-line matching (defense against regex metacharacters)
if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qFx "$WORKSPACE_ID"; then
    echo -e "${RED}Error: Docker container '$WORKSPACE_ID' exists but no matching DevPod workspace${NC}"
    echo "Remove orphaned container: docker rm $WORKSPACE_ID"
    exit 1
fi

# Build local image if requested
if [[ "$LOCAL_BUILD" == true ]]; then
    if [[ ! -f "$REPO_ROOT/image/Dockerfile" ]]; then
        echo -e "${RED}Error: Cannot find image/Dockerfile in $REPO_ROOT${NC}"
        exit 1
    fi

    echo -e "${BLUE}Building local Docker image...${NC}"
    docker build -f "$REPO_ROOT/image/Dockerfile" -t "$LOCAL_IMAGE" "$REPO_ROOT"
    echo ""
fi

# Pull fresh remote image if requested (skip if using local build)
if [[ "$PULL_FRESH" == true && "$LOCAL_BUILD" == false ]]; then
    echo -e "${BLUE}Pulling fresh remote image (invalidating cache)...${NC}"
    docker pull "$FALLBACK_IMAGE"
    echo ""
fi

echo -e "${GREEN}Creating DevPod workspace${NC}"
echo -e "  Repo:      $REPO_NAME"
echo -e "  Instance:  $SHORT_ID"
echo -e "  Workspace: $WORKSPACE_ID (also container name)"
if [[ "$LOCAL_BUILD" == true ]]; then
    echo -e "  Image:     $LOCAL_IMAGE (local build)"
elif [[ "$PULL_FRESH" == true ]]; then
    echo -e "  Image:     $FALLBACK_IMAGE (freshly pulled)"
fi
if [[ "$IS_REMOTE" == true ]]; then
    if [[ "$USE_DEVPOD_CONFIG" == true ]]; then
        echo -e "  Config:    .devcontainer/devpod/devcontainer.json (from cloned repo)"
    else
        echo -e "  Source:    remote (fallback image if no devcontainer.json)"
    fi
else
    echo -e "  Config:    .devcontainer/devpod/devcontainer.json"
fi
echo ""

# Build the devpod command
DEVPOD_ARGS=("$REPO" --id "$WORKSPACE_ID")

# Always provide fallback image for repos without devcontainer.json
# This enables using our full environment with any third-party repository
DEVPOD_ARGS+=(--fallback-image "$FALLBACK_IMAGE")

# Handle devcontainer.json selection
# Note: --devcontainer-path expects a path RELATIVE to the repo root
DEVCONTAINER_CONFIG_ABS="$REPO_ROOT/.devcontainer/devpod/devcontainer.json"
DEVCONTAINER_CONFIG_REL=".devcontainer/devpod/devcontainer.json"

if [[ "$IS_REMOTE" == false ]]; then
    # For local repos, use our DevPod-specific config if it exists
    if [[ ! -f "$DEVCONTAINER_CONFIG_ABS" ]]; then
        echo -e "${YELLOW}Warning: devcontainer.json not found at $DEVCONTAINER_CONFIG_ABS${NC}"
        echo -e "${YELLOW}Relying on fallback image configuration${NC}"
    else
        DEVPOD_ARGS+=(--devcontainer-path "$DEVCONTAINER_CONFIG_REL")
    fi
elif [[ "$USE_DEVPOD_CONFIG" == true ]]; then
    # Use DevPod-specific config (via --devpod-config flag or config file match)
    DEVPOD_ARGS+=(--devcontainer-path "$DEVCONTAINER_CONFIG_REL")
fi
# For other remote repos, let DevPod auto-discover (uses fallback image if no config found)

# Add local image if requested
if [[ "$LOCAL_BUILD" == true ]]; then
    DEVPOD_ARGS+=(--devcontainer-image "$LOCAL_IMAGE")
fi

# Skip IDE if requested
if [[ "$NO_IDE" == true ]]; then
    DEVPOD_ARGS+=(--ide none)
fi

exec devpod up "${DEVPOD_ARGS[@]}" "$@"
